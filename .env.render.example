# =============================================================================
# Render env-var reference for hrSystem
# =============================================================================
# Most of these are already declared in render.yaml (as literal `value:`,
# `fromDatabase:` references, or `sync: false` placeholders you fill in via
# the Render dashboard after the Blueprint deploy). This file is just a
# human-readable reference of what ends up set, for local comparison.
# =============================================================================

# --- App identity ---
APP_NAME=hrSystem
APP_ENV=production
APP_KEY=REPLACE_ME_run__php_artisan_key_generate__--show__locally_then_paste
APP_DEBUG=false
APP_URL=REPLACE_ME_your_onrender_or_custom_domain
APP_LOCALE=km
APP_FALLBACK_LOCALE=en

# --- Database (Render-managed Postgres, see render.yaml `databases:` block) ---
# Values below are auto-injected by Render via `fromDatabase` references —
# you do not set them manually in the dashboard.
DB_CONNECTION=pgsql
DB_HOST=AUTO__render_postgres_internal_host
DB_PORT=AUTO__render_postgres_port
DB_DATABASE=AUTO__render_postgres_database
DB_USERNAME=AUTO__render_postgres_user
DB_PASSWORD=AUTO__render_postgres_password

# --- Cache / Session / Queue ---
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# --- Filesystem ---
# Render's container disk is ephemeral (wiped on every deploy) unless you
# attach a persistent disk, and disks can't be shared across the web +
# worker + cron services here — so R2 is required, not optional, unlike
# the local dev default.
FILESYSTEM_DISK=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=REPLACE_ME
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REPLACE_ME
CLOUDFLARE_R2_BUCKET=REPLACE_ME
CLOUDFLARE_R2_ENDPOINT=REPLACE_ME_https__your_account_id_r2_cloudflarestorage_com
CLOUDFLARE_R2_URL=REPLACE_ME_public_r2_url_OR_custom_domain

# --- Mail (optional but recommended; defaults to log driver) ---
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram (plan reminders) ---
TELEGRAM_BOT_TOKEN=REPLACE_ME_get_from_BotFather
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Broadcasting (optional) ---
BROADCAST_CONNECTION=log
