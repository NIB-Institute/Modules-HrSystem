# =============================================================================
# Railway env-var template for hrSystem
# =============================================================================
# Copy each KEY into Railway's "Variables" tab on the web service.
# Values prefixed with "REPLACE_ME" must be filled in by you.
# Values prefixed with "AUTO" come from Railway service references (Postgres
# add-on, etc.) — set them as ${{ Postgres.PGHOST }} style references in
# Railway's variables UI.
# =============================================================================

# --- App identity ---
APP_NAME=hrSystem
APP_ENV=production
APP_KEY=REPLACE_ME_run__php_artisan_key_generate__locally_then_paste
APP_DEBUG=false
APP_URL=https://hrsite.online
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database (Railway MySQL add-on) ---
# Add a MySQL database to your Railway project, then reference these:
DB_CONNECTION=mysql
DB_HOST=AUTO__use__${{ MySQL.MYSQLHOST }}
DB_PORT=AUTO__use__${{ MySQL.MYSQLPORT }}
DB_DATABASE=AUTO__use__${{ MySQL.MYSQLDATABASE }}
DB_USERNAME=AUTO__use__${{ MySQL.MYSQLUSER }}
DB_PASSWORD=AUTO__use__${{ MySQL.MYSQLPASSWORD }}

# --- Cache / Session / Queue ---
# Database driver is the simplest start; switch to Redis later if needed.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# --- Filesystem ---
# 'public' = local disk (ephemeral on Railway — files lost on every deploy).
# Switch to 's3' when you wire Cloudflare R2 (recommended for prod).
FILESYSTEM_DISK=public

# --- Mail (optional but recommended; defaults to log driver) ---
MAIL_MAILER=log
# When ready to send real email (e.g. SES, Mailgun, Resend):
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram (plan reminders) ---
TELEGRAM_BOT_TOKEN=REPLACE_ME_get_from_BotFather
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Broadcasting (optional) ---
BROADCAST_CONNECTION=log

# =============================================================================
# Cloudflare R2 / AWS S3 — uncomment + fill when migrating off ephemeral storage
# =============================================================================
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=REPLACE_ME_r2_access_key
# AWS_SECRET_ACCESS_KEY=REPLACE_ME_r2_secret
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=REPLACE_ME_bucket_name
# AWS_ENDPOINT=REPLACE_ME_https__your_account_id_r2_cloudflarestorage_com
# AWS_URL=REPLACE_ME_public_r2_url_OR_custom_domain
# AWS_USE_PATH_STYLE_ENDPOINT=true
