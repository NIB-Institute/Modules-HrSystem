# Caddyfile for Railway / FrankenPHP — routes requests through Laravel's public/index.php.
# Railway's auto-detect uses FrankenPHP + Caddy and looks for this file at /app/Caddyfile.

{
	frankenphp
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /app/public

	encode zstd br gzip

	php_server {
		# Required so PHP-FPM knows the real client IP (Railway's edge proxy).
		trusted_proxies static 0.0.0.0/0
	}

	file_server

	log {
		output stdout
		format console
		level INFO
	}
}
